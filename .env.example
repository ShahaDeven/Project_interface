# Copy to .env (gitignored) and fill in. Values here are never committed.

# Required for discovery. Replay never reads it — replay makes no model calls.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the discovery model.
# CUA_MODEL=claude-sonnet-5

# Credentials the capability declares in `requires_secrets`, resolved as
# CUA_SECRET_<NAME_UPPERCASED>. The model never receives these — it types the
# token {secrets.operator_id} and the executor substitutes the value at the
# keystroke, so the credential never enters a transcript, trace or artifact.
#
# The target app accepts any credentials; these exist so the mechanism is real.
CUA_SECRET_OPERATOR_ID=e.okafor
CUA_SECRET_OPERATOR_PASSWORD=not-a-real-password
