# --- secrets ------------------------------------------------------------------
# Discovery needs an Anthropic API key. It goes in .env and never in the repo.
.env
.env.*
!.env.example
*.key

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- virtualenvs --------------------------------------------------------------
.venv/
venv/
env/

# --- tooling caches -----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- run output ---------------------------------------------------------------
# Per-run evidence is disposable and heavy: screenshots, DOM snapshots and full
# model transcripts, one directory per run. Live runs write to run_<timestamp>/
# and stay local.
evidence/run_*/
*.log

# The curated evidence set IS committed — the storytelling minimum from DESIGN
# §10, so a reviewer who never runs the code can still read what happened.
#
# A run is published by renaming it to NN_<mode>_<scenario>/, which the rule above
# deliberately does not match. The naming convention is therefore what decides
# whether a run ships, and nothing has to be remembered: timestamped is
# disposable, numbered is published. The number also makes `ls evidence/` print
# the set in the order the story is meant to be read, on every OS.

# --- editors / OS -------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- local only, not part of the submission -----------------------------------
# The brief itself is interface.ai's assessment material and not ours to
# republish. Leading "/" anchors to the repo root, this file's directory.
/Assignment A — Computer-Use Automation System.pdf
